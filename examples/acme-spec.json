{
  "name": "ACME-POS",
  "description": "Example of a customised layout: ASCII ISO 8583:1987 with a positional field 48 and a bitmapped field 62. Not a real network spec.",
  "mtiEncoding": "ascii",
  "bitmapEncoding": "hex",
  "defaults": {
    "numeric": "ascii",
    "text": "ascii",
    "binary": "hex",
    "prefix": "ascii"
  },
  "fields": {
    "2": { "name": "Primary account number (PAN)", "type": "n", "length": 19, "lengthType": "llvar", "mask": "pan" },
    "3": { "name": "Processing code", "type": "n", "length": 6 },
    "4": { "name": "Amount, transaction", "type": "n", "length": 12, "pad": "left" },
    "7": { "name": "Transmission date and time", "type": "n", "length": 10 },
    "11": { "name": "System trace audit number (STAN)", "type": "n", "length": 6, "pad": "left" },
    "12": { "name": "Time, local transaction (hhmmss)", "type": "n", "length": 6 },
    "13": { "name": "Date, local transaction (MMDD)", "type": "n", "length": 4 },
    "14": { "name": "Date, expiration (YYMM)", "type": "n", "length": 4, "mask": "full" },
    "22": { "name": "Point of service entry mode", "type": "n", "length": 3 },
    "28": { "name": "Amount, transaction fee", "type": "xn", "length": 8, "pad": "left" },
    "35": { "name": "Track 2 data", "type": "z", "length": 37, "lengthType": "llvar", "mask": "track" },
    "37": { "name": "Retrieval reference number", "type": "an", "length": 12 },
    "38": { "name": "Authorization identification response", "type": "an", "length": 6 },
    "39": { "name": "Response code", "type": "an", "length": 2 },
    "41": { "name": "Card acceptor terminal identification", "type": "ans", "length": 8, "pad": "right" },
    "42": { "name": "Card acceptor identification code", "type": "ans", "length": 15, "pad": "right" },
    "48": {
      "name": "Additional data (private)",
      "type": "ans",
      "length": 999,
      "lengthType": "lllvar",
      "composite": {
        "kind": "positional",
        "fields": {
          "1": { "name": "Installments", "type": "n", "length": 2, "pad": "left" },
          "2": { "name": "CVV2", "type": "n", "length": 3, "mask": "full" },
          "3": { "name": "Merchant order reference", "type": "ans", "length": 20, "lengthType": "llvar" }
        }
      }
    },
    "49": { "name": "Currency code, transaction", "type": "n", "length": 3 },
    "52": { "name": "PIN block", "type": "b", "length": 8, "mask": "full" },
    "55": { "name": "ICC system related data (EMV)", "type": "b", "length": 255, "lengthType": "lllvar", "composite": { "kind": "tlv" } },
    "62": {
      "name": "Terminal data (private)",
      "type": "ans",
      "length": 999,
      "lengthType": "lllvar",
      "composite": {
        "kind": "bitmapped",
        "bitmapBytes": 8,
        "fields": {
          "1": { "name": "Terminal serial number", "type": "ans", "length": 20, "lengthType": "llvar" },
          "2": { "name": "Application version", "type": "an", "length": 6, "pad": "right" },
          "8": { "name": "Batch number", "type": "n", "length": 6, "pad": "left" }
        }
      }
    },
    "70": { "name": "Network management information code", "type": "n", "length": 3 },
    "90": { "name": "Original data elements", "type": "n", "length": 42 },
    "128": { "name": "Message authentication code (MAC)", "type": "b", "length": 8 }
  }
}
